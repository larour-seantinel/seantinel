# Dependencies
node_modules/

# Build outputs
dist/
build/
build-tmp/

# Session-local scratch
claudeproject

# Data / outputs (future dirs)
data/
output/
# Keep packaged APK assets (not local scratch).
!android-spike/assets/data/
# Keep website data served by Vite.
!public/data/
# /dev viewer snapshots — regenerated by scripts/runme.py
public/dev/

# Binary/document strays
*.pdf
*.docx
*.xlsx
*.pptx
*.parquet
*.zip
*.png
*.jpg
*.jpeg
*.gif
*.webp
# But keep images bundled with the website or the APK.
!public/data/*.png
!public/data/*.jpg
!android-spike/assets/data/*.png
# Launcher icons must ship with the APK.
!android-spike/res/mipmap-*/
!android-spike/res/mipmap-*/*.png
!android-todo/res/mipmap-*/
!android-todo/res/mipmap-*/*.png

# Env and secrets
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
